# Medical production-like profile. Keys stay in the process environment or a
# secret manager; never write real credentials into this file.
RAGLAB_EMBEDDING_BACKEND=openai-compatible
RAGLAB_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAGLAB_EMBEDDING_MODEL=text-embedding-v4
RAGLAB_EMBEDDING_DIMENSIONS=1024
RAGLAB_EMBEDDING_BATCH_SIZE=10
RAGLAB_EMBEDDING_VERSION=dashscope-text-embedding-v4-1024-v1
RAGLAB_MILVUS_COLLECTION=raglab_chunks_dashscope_v4_1024
RAGLAB_RERANK_BACKEND=qwen
RAGLAB_RERANK_MODEL=qwen3-rerank
RAGLAB_RERANK_STRICT=false
RAGLAB_GENERATION_PROVIDER=deepseek
RAGLAB_GENERATION_MODEL=deepseek-chat

# Deterministic CI/offline override (not the medical acceptance profile):
# RAGLAB_EMBEDDING_BACKEND=hash
# RAGLAB_HASH_EMBEDDING_DIMENSIONS=1024
# RAGLAB_RERANK_BACKEND=heuristic
# RAGLAB_GENERATION_PROVIDER=extractive

# Optional local embedding profile:
# RAGLAB_EMBEDDING_BACKEND=ollama
# RAGLAB_OLLAMA_URL=http://host.docker.internal:11434
# RAGLAB_OLLAMA_MODEL=qwen3-embedding:4b-local
# Optional: ask Ollama/Qwen3 for the same 1024-dim profile used by the remote setup.
# Changing this requires a new Milvus collection and a full re-index.
# RAGLAB_EMBEDDING_DIMENSIONS=1024
# The embedding model and generation model are deliberately configured separately.
# RAGLAB_EMBEDDING_API_KEY=replace-with-your-embedding-token
# Alternatively keep the key outside files and expose it to the local shell:
# launchctl setenv QWEN_API_KEY 'replace-with-your-bailian-key'
# The medical schema adds dataset/model/provenance fields, so use a new
# versioned collection instead of mutating an existing index in place.
# RAGLAB_LIFECYCLE_COLLECTION=raglab_knowledge_medical_v3_1024
# RAGLAB_LIFECYCLE_ALIAS=raglab_knowledge_active_v3
# Enable exact identifier + BM25 + dense retrieval with Milvus-side RRF.
RAGLAB_HYBRID_SEARCH=true
# RAGLAB_RERANK_API_KEY=replace-with-your-bailian-key
# qwen3-rerank uses the compatible rerank endpoint, not the legacy endpoint
# used by gte-rerank-v2 and multimodal rerank models.
# RAGLAB_RERANK_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks
# Keep false for an availability-first fallback to deterministic reranking.
# RAGLAB_GENERATION_API_KEY=replace-with-your-deepseek-token
# DEEPSEEK_API_KEY=replace-with-your-deepseek-token

# Change these before exposing the stack beyond localhost.
RAGLAB_AUTH_SECRET=raglab-local-development-secret-change-me
RAGLAB_PLATFORM_ADMIN_PASSWORD=change-this-admin-password
RAGLAB_AUTH_ISSUER=raglab-local
RAGLAB_AUTH_AUDIENCE=raglab-api
# Set to true for any customer-facing deployment. Startup then fails closed
# unless RAGLAB_AUTH_OIDC_ISSUER or RAGLAB_AUTH_JWKS_URL is configured.
# RAGLAB_REQUIRE_OIDC=true
# RAGLAB_AUTH_OIDC_ISSUER=https://id.example.com/realms/acme
# RAGLAB_AUTH_JWKS_URL=https://id.example.com/realms/acme/protocol/openid-connect/certs

# Compose-only infrastructure credentials. Keep these in a secret manager for
# production; do not commit a populated .env file.
RAGLAB_POSTGRES_PASSWORD=raglab-local
RAGLAB_MINIO_ROOT_USER=minioadmin
RAGLAB_MINIO_ROOT_PASSWORD=minioadmin
RAGLAB_DOCUMENT_PARSER_PORT=8070
# Compose injects the internal parser and MinIO addresses automatically.
# RAGLAB_DOCUMENT_PARSER_URL=http://parser:8070
# RAGLAB_DOCUMENT_STORE_ENDPOINT=minio:9000
# RAGLAB_DOCUMENT_STORE_BUCKET=raglab-documents
# For managed PostgreSQL in production, override the full URL and require TLS.
# RAGLAB_POSTGRES_URL=postgres://user:password@tencentdb.example/raglab?sslmode=verify-full

# Runtime observability, quota and cost controls.
# RAGLAB_OTEL_ENDPOINT=http://127.0.0.1:4318
# RAGLAB_OTEL_SERVICE_NAME=rag-evolution-lab
RAGLAB_RATE_LIMIT_RPM=120
RAGLAB_RATE_LIMIT_BURST=30
RAGLAB_TOKEN_QUOTA_PER_MINUTE=100000
# Compose defaults to a shared Redis limiter; use memory for a single-process lab.
RAGLAB_RATE_LIMIT_BACKEND=redis
RAGLAB_REDIS_URL=redis://redis:6379/0
RAGLAB_REDIS_PREFIX=raglab:ratelimit
# RAGLAB_COST_INPUT_USD_PER_1M=0
# RAGLAB_COST_OUTPUT_USD_PER_1M=0

# Host ports.
RAGLAB_API_PORT=8080
RAGLAB_AGENT_PORT=8090
RAGLAB_WEB_PORT=3000
RAGLAB_MILVUS_PORT=19530
RAGLAB_MILVUS_HEALTH_PORT=9091
RAGLAB_POSTGRES_PORT=5433
RAGLAB_REDIS_PORT=6379
NEXT_PUBLIC_API_BASE=http://localhost:8080
NEXT_PUBLIC_AGENT_API_BASE=http://localhost:8090

# Enterprise runtime regression harness (optional; defaults target the local lab).
# RAGLAB_ENTERPRISE_EVAL_EMAIL=alice@tenant-a.local
# RAGLAB_ENTERPRISE_EVAL_PASSWORD=RagLab-Alice-2026!
# RAGLAB_ENTERPRISE_EVAL_APP_ID=tenant_a-support-agent
# RAGLAB_ENTERPRISE_EVAL_CROSS_APP_ID=tenant_b-support-agent
