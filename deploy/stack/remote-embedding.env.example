# Copy this file to an ignored local file such as .env.remote and chmod 600.
# Put the real key in launchctl/system environment or the ignored file only.

RAGLAB_EMBEDDING_BACKEND=openai-compatible
RAGLAB_EMBEDDING_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
RAGLAB_EMBEDDING_MODEL=text-embedding-v4
RAGLAB_EMBEDDING_DIMENSIONS=1024
RAGLAB_EMBEDDING_BATCH_SIZE=10
RAGLAB_EMBEDDING_VERSION=dashscope-text-embedding-v4-1024-v1
RAGLAB_QUERY_INSTRUCTION="Given a user query, retrieve passages that directly answer the query"
RAGLAB_MILVUS_COLLECTION=raglab_chunks_dashscope_v4_1024
RAGLAB_LIFECYCLE_COLLECTION=raglab_lifecycle_dashscope_v4_1024
RAGLAB_LIFECYCLE_ALIAS=raglab_knowledge_dashscope_v4_1024
RAGLAB_LIFECYCLE_STATE=/var/lib/raglab/lifecycle/dashscope_v4_1024_state.json

# Key options, in priority order:
# 1. RAGLAB_EMBEDDING_API_KEY
# 2. QWEN_API_KEY (recommended launchctl variable for local macOS use)
# 3. DASHSCOPE_API_KEY
# 4. TOKENHUB_API_KEY
